{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "headers": {
      "Idempotency-Key": {
        "matches": ".+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.externalId"
      },
      {
        "matchesJsonPath": "$.customerId"
      },
      {
        "matchesJsonPath": "$[?(@.productCode == 'TEMPORARY-ERROR')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "TEMPORARY_FAILURE"
    }
  }
}
